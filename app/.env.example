# PostgreSQL (met optioneel pgvector)
DATABASE_URL=postgres://pr:pr@localhost:5432/politierechter
# Beheerdersaccount (wordt bij `npm run db:seed` aangemaakt)
ADMIN_EMAIL=beheer@politierechter.nl
ADMIN_PASSWORD=wijzig-dit-wachtwoord
# Optioneel: AI-analyse via Claude (zonder sleutel draait het platform volledig regelgebaseerd)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Optioneel: semantisch zoeken (Voyage AI embeddings, voyage-law-2)
VOYAGE_API_KEY=
# Import
IMPORT_MIN_INTERVAL_MS=350
IMPORT_USER_AGENT=PolitierechterNL-onderzoeksimport/0.1 (+https://politierechter.nl/over)
# Node's fetch gebruikt alleen een proxy met deze vlag (Node >= 22.21)
# NODE_USE_ENV_PROXY=1
